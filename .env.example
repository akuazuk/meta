# Источник истины – Secret Manager project protocol-home-e1 (как Протокол).
# bash scripts/pull_env_from_sm.sh
# bash scripts/push_secrets_to_sm.sh

# ==== Meta App (developers.facebook.com) ====
META_APP_ID=
META_APP_SECRET=

# ==== Access token (рабочий по умолчанию; обычно = OLD) ====
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- META OLD (Artox / PLN) — Conversions API System User ---
META_ACCESS_TOKEN_OLD=
META_AD_ACCOUNT_ID_OLD=723170300839405

# --- META NEW (MRS / USD) — MRS_S_User ---
META_ACCESS_TOKEN_MRS=
META_AD_ACCOUNT_ID_MRS=2649521998797481
META_DATASET_ID_MRS=1064023126171171
# Test Events код для NEW dataset (Events Manager → Kravira_MRS_CAPI → Test Events)
META_TEST_EVENT_CODE_MRS=

# ==== Page / Instagram (органика и привязка креативов) ====
META_PAGE_ID=
META_INSTAGRAM_ID=

# ==== Conversions API / Events Manager (OLD dataset) ====
# ID Dataset (он же Pixel ID в большинстве аккаунтов) для отправки серверных событий.
META_DATASET_ID=

# Код из вкладки Test Events в Events Manager. Пока задан — события идут в тестовый поток,
# не влияют на оптимизацию и видны в реальном времени. На проде оставить пустым.
META_TEST_EVENT_CODE=

# ==== Прочее ====
# Версия Graph API закреплена для воспроизводимости.
META_GRAPH_API_VERSION=v25.0

# ==== Google Ads API (агентство → клиенты) ====
# Подробно: docs/GOOGLE_ADS_SETUP.md
# Доступ BASIC на Cloud-проекте OAuth-клиента. Developer token не нужен.
# OAuth Desktop из Google Cloud (НЕ номер аккаунта XXX-XXX-XXXX)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Один раз: python -m scripts.google_ads_oauth
GOOGLE_ADS_REFRESH_TOKEN=
# MCC агентства без дефисов
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Клиентский аккаунт без дефисов (меняется по задаче)
GOOGLE_ADS_CUSTOMER_ID=

# ==== HeyGen API (AI video) ====
# Settings → API: https://app.heygen.com/home?from=&nav=API
HEYGEN_API_KEY=
