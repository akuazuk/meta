# ==== Meta App (developers.facebook.com) ====
META_APP_ID=
META_APP_SECRET=

# ==== Access token ====
# Долгоживущий токен System User из Business Manager (рекомендуется для автоматизации).
# Для локальных экспериментов можно временно вставить короткоживущий user-токен
# и обменять его на долгоживущий скриптом scripts/exchange_token.py
META_ACCESS_TOKEN=

# ==== Рекламный аккаунт ====
# Можно указывать с префиксом act_ или без него.
META_AD_ACCOUNT_ID=

# ==== Conversions API / Events Manager ====
# ID Dataset (он же Pixel ID в большинстве аккаунтов) для отправки серверных событий.
META_DATASET_ID=

# Код из вкладки Test Events в Events Manager. Пока задан — события идут в тестовый поток,
# не влияют на оптимизацию и видны в реальном времени. На проде оставить пустым.
META_TEST_EVENT_CODE=

# ==== Прочее ====
# Версия Graph API. Пусто = версия по умолчанию из SDK.
META_GRAPH_API_VERSION=
