# =============================
# Meta Ads Integration .env
# Fill values and rename to .env
# =============================

# ---- Meta App (developers.facebook.com) [REQUIRED] ----
# App ID from your Meta App (Business type, Marketing API enabled)
META_APP_ID=

# App Secret from the same Meta App
META_APP_SECRET=

# ---- Access Token [REQUIRED] ----
# Recommended: long-lived System User token from Business Manager.
# Must include scopes:
# ads_management, ads_read, business_management, leads_retrieval
META_ACCESS_TOKEN=

# ---- Ads Account [RECOMMENDED] ----
# Target ad account ID (can be with or without "act_" prefix)
# Example: 123456789012345 or act_123456789012345
META_AD_ACCOUNT_ID=

# ---- Conversions API / Events Manager [REQUIRED for CAPI] ----
# Dataset ID (often equal to Pixel ID) for server-side events
META_DATASET_ID=

# Test Events code from Events Manager.
# Keep for sandbox/testing; leave empty in production.
META_TEST_EVENT_CODE=

# ---- Optional ----
# Graph API version is pinned for reproducibility.
META_GRAPH_API_VERSION=v25.0

# ---- Google Ads API (agency → client accounts) [for Google contour] ----
# See docs/GOOGLE_ADS_SETUP.md
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
